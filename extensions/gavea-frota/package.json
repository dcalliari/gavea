{
	"name": "gavea-frota",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.1.0",
	"publisher": "gavea",
	"license": "MIT",
	"engines": { "vscode": "^1.99.0" },
	"activationEvents": ["onView:gavea.frota", "onCommand:gavea.frota.openDeck"],
	"main": "./out/extension",
	"contributes": {
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"gavea.frota.intervaloAtualizacao": {
					"type": "number",
					"default": 10,
					"minimum": 1,
					"description": "%config.refreshInterval%"
				}
			}
		},
		"viewsContainers": { "activitybar": [{ "id": "gavea-frota", "title": "%container.title%", "icon": "./gavea-mark.svg" }] },
		"views": { "gavea-frota": [{ "id": "gavea.frota", "name": "%view.title%" }] },
		"commands": [
			{ "command": "gavea.frota.openDeck", "title": "%command.openDeck%", "icon": "$(layout-centered)" },
			{ "command": "gavea.frota.refresh", "title": "%command.refresh%", "icon": "$(refresh)" },
			{ "command": "gavea.frota.openTaskDiff", "title": "%command.openTaskDiff%", "icon": "$(git-compare)" },
			{ "command": "gavea.frota.openTaskWorktree", "title": "%command.openTaskWorktree%" },
			{ "command": "gavea.frota.openTaskSourceControl", "title": "%command.openTaskSourceControl%" }
		],
		"menus": {
			"view/title": [{ "command": "gavea.frota.refresh", "when": "view == gavea.frota", "group": "navigation" }],
			"view/item/context": [
				{ "command": "gavea.frota.openTaskDiff", "when": "view == gavea.frota && viewItem == gavea.frota.task", "group": "inline@1" },
				{ "command": "gavea.frota.openTaskWorktree", "when": "view == gavea.frota && viewItem == gavea.frota.task", "group": "inline@2" },
				{ "command": "gavea.frota.openTaskSourceControl", "when": "view == gavea.frota && viewItem == gavea.frota.task", "group": "inline@3" }
			],
			"commandPalette": [
				{ "command": "gavea.frota.openDeck" },
				{ "command": "gavea.frota.refresh" },
				{ "command": "gavea.frota.openTaskDiff" }
			]
		}
	},
	"scripts": { "compile": "npx gulp compile-extension:gavea-frota", "test": "node --experimental-strip-types --test src/test/*.test.ts" },
	"devDependencies": { "@types/node": "24.x" }
}
